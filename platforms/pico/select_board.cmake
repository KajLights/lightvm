# Board selection is needed before the SDK import and compiler detection.
if(NOT DEFINED PICO_BOARD)
    if(DEFINED ENV{PICO_BOARD} AND NOT "$ENV{PICO_BOARD}" STREQUAL "")
        set(PICO_BOARD "$ENV{PICO_BOARD}" CACHE STRING "Pico board")
    else()
        set(PICO_BOARD pico CACHE STRING "Pico board")
    endif()
endif()
set_property(CACHE PICO_BOARD PROPERTY STRINGS pico pico_w pico2_w)
if(NOT PICO_BOARD MATCHES "^(pico|pico_w|pico2_w)$")
    message(FATAL_ERROR "Unsupported PICO_BOARD='${PICO_BOARD}'; choose pico, pico_w or pico2_w")
endif()
if(DEFINED LIGHTVM_PICO_BOARD AND NOT LIGHTVM_PICO_BOARD STREQUAL PICO_BOARD)
    message(FATAL_ERROR "PICO_BOARD changed from ${LIGHTVM_PICO_BOARD} to ${PICO_BOARD}; use a fresh build directory")
endif()
set(LIGHTVM_PICO_BOARD "${PICO_BOARD}" CACHE INTERNAL "Configured Pico board")
if(PICO_BOARD STREQUAL "pico2_w")
    set(LIGHTVM_PICO_PLATFORM rp2350-arm-s)
else()
    set(LIGHTVM_PICO_PLATFORM rp2040)
endif()
if(NOT DEFINED PICO_PLATFORM AND DEFINED ENV{PICO_PLATFORM})
    set(PICO_PLATFORM "$ENV{PICO_PLATFORM}")
endif()
if(DEFINED PICO_PLATFORM AND NOT PICO_PLATFORM STREQUAL LIGHTVM_PICO_PLATFORM)
    message(FATAL_ERROR "${PICO_BOARD} requires PICO_PLATFORM=${LIGHTVM_PICO_PLATFORM}")
endif()
set(PICO_PLATFORM "${LIGHTVM_PICO_PLATFORM}" CACHE STRING "Pico chip/architecture")
