include("${CMAKE_CURRENT_LIST_DIR}/select_board.cmake")
if(NOT PICO_SDK_PATH)
    set(PICO_SDK_PATH "$ENV{PICO_SDK_PATH}")
endif()
if(NOT EXISTS "${PICO_SDK_PATH}/pico_sdk_init.cmake")
    message(FATAL_ERROR "Set PICO_SDK_PATH to a Pico SDK checkout with its TinyUSB submodule")
endif()
include("${PICO_SDK_PATH}/external/pico_sdk_import.cmake")
include("${PICO_SDK_PATH}/pico_sdk_version.cmake")
if(PICO_SDK_VERSION_STRING VERSION_LESS "2.3.1")
    message(FATAL_ERROR "LightVM requires Pico SDK 2.3.1 or newer; use a fresh build directory after upgrading")
endif()
