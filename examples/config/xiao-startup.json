{
  "schema": "lightvm.config",
  "outputs": [
    {
      "id": "lights",
      "type": "ws2812b",
      "config": {
        "pin": "D0",
        "count": 100,
        "order": "GRB",
        "brightness_limit": 32
      },
      "startup": {
        "program": "rainbow",
        "inputs": {
          "phase": {
            "driver": {
              "kind": "ramp",
              "duration": 3.3,
              "mode": "repeat"
            }
          }
        }
      }
    }
  ]
}
