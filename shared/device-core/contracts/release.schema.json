{
  "type": "object",
  "properties": {
    "schema": {
      "const": "kajlights.release"
    },
    "manifest_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,180}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 95,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\u0000- \u007f]"
      }
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "channel": {
      "enum": [
        "development",
        "prerelease",
        "stable"
      ]
    },
    "distribution": {
      "enum": [
        "public",
        "private"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "workflow": {
          "const": ".github/workflows/release.yml"
        },
        "attestation_required": {
          "type": "boolean"
        }
      },
      "required": [
        "workflow",
        "attestation_required"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "urn:kajlights:firmware"
      }
    }
  },
  "required": [
    "schema",
    "manifest_version",
    "repository",
    "product",
    "version",
    "source_revision",
    "tag",
    "channel",
    "distribution",
    "provenance",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kajlights:release"
}
