{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kajlights device metadata operations",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "const": "device_metadata_get"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "op",
        "nickname",
        "expected_revision",
        "expected_boot_id"
      ],
      "properties": {
        "op": {
          "const": "device_metadata_set"
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
          "description": "At most 63 UTF-8 bytes; trim ASCII spaces; empty becomes null."
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "expected_boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false
    }
  ]
}
